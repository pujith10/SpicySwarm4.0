# =====================================================================
# SPICY SWARM 4.0 - API KEYS & CONFIGURATION
# =====================================================================

# 1. OpenRouter API Key (PASTE YOUR KEY HERE)
# Provides top-tier free models for Critic, Architect, Synthesizer, Analyst, and Librarian
OPENROUTER_API_KEY=

# 2. Fallback APIs (Used when OpenRouter rate limits or capacity are exceeded)
GOOGLE_API_KEY=
GROQ_API_KEY=

# 3. Security & System Configuration
SIGNUP_SECRET=spicy3.0
AUTH_SECRET_KEY=spicy_secret_swarm_key_3.0_v9_!@#
ENVIRONMENT=development
MAX_CYCLES=7
SCRUBBING_ENABLED=true

# 4. Storage & Retrieval
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://localhost:6379
FAISS_INDEX_PATH=backend/data/faiss.index
